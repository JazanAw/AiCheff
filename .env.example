# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe Configuration
# Doku-Platzhalter — die echten Werte gehören in die Supabase Edge Function
# Secrets (`supabase secrets set ...`), NICHT ins Repo. Siehe docs/stripe-integration.md.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=
# Rückkehr-Ziele für Stripe Checkout/Portal. Stripe Checkout verlangt ggf.
# http(s)-URLs — dann hier eine https-Bounce-Seite eintragen, die ins App-Scheme
# weiterleitet. App-Scheme `cheffity` ist in mobile/app.json gesetzt.
APP_DEEP_LINK_SUCCESS=cheffity://subscription/success
APP_DEEP_LINK_CANCEL=cheffity://subscription/cancel

# AI Provider Configuration
AI_PROVIDER=local
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Backend + Web-MVP read VITE_OLLAMA_* (legacy Vite prefix; the backend
# reads it too because dotenv ignores the prefix). The default in code is
# qwen3:14b fits 12 GB VRAM as Q4_K_M. If you change this, also pull the
# model: `ollama pull <model>`.
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=qwen3:14b
VITE_OLLAMA_TIMEOUT_MS=20000

# Google Custom Search (Bildsuche für den manuellen Lidl-Prospektbilder-Import,
# lidlPageOfferImageSearch.ts). Backend-only Secret — bewusst NICHT VITE_-
# präfixiert, damit der Key nicht Richtung Frontend/Mobile sichtbar wird (wird
# per process.env gelesen, nicht über appConfig). Ohne Werte läuft der Import
# fallback-sicher weiter und behält das Prospekt-Seitenbild.
# Setup: Google-Cloud-Projekt mit aktivierter "Custom Search API" + API-Key,
# dazu eine Programmable Search Engine (https://programmablesearchengine.google.com/)
# mit aktivierter Bildsuche + "gesamtes Web durchsuchen".
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Listen-Adresse des Backends. Ohne Eintrag bindet der Server an 127.0.0.1
# und ist NUR von diesem Rechner erreichbar. Das ist Absicht: der Prozess hat
# keine Auth-Middleware und haelt den Supabase-Service-Role-Key (umgeht RLS).
#
# Fuer Handy-Tests im WLAN (Expo Go gegen http://<PC-IP>:8787) auf 0.0.0.0
# setzen. Dann sind /admin-v2 samt Shutdown-/Scan-Endpoints fuer JEDEN im
# selben Netz offen — nur in vertrauenswuerdigen Netzen verwenden und danach
# wieder auskommentieren. Der Server warnt beim Start laut, wenn aktiv.
# BIND_HOST=0.0.0.0

# Other Configuration
ENVIRONMENT=development
