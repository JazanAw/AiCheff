# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# KEIN AI-Key hier. Entfernt am 2026-08-04 zusammen mit mobile/src/ai/.
#
# EXPO_PUBLIC_* wird von Expo beim Build IN das App-Bundle eingebacken und
# ist aus jeder APK/IPA mit `unzip` + `strings` auslesbar. Ein Anbieter-Key
# (Anthropic o. a.) darf hier deshalb NIE stehen — er waere sofort oeffentlich
# und auf deine Rechnung nutzbar.
#
# Wenn die App spaeter KI braucht: als Supabase Edge Function bauen, den Key
# per `supabase secrets set` hinterlegen und die Function mit dem User-JWT
# aufrufen. Dann verlaesst der Key nie den Server.

# Google OAuth (Native ID-token flow via expo-auth-session)
# Create OAuth client IDs in Google Cloud Console -> Credentials.
# iOS: type "iOS" with bundle id com.cheffity.app
# Android: type "Android" with package com.cheffity.app + SHA-1
# Web: type "Web" -- needed by Expo Go and as audience for Supabase token validation.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# External (web) Stripe checkout. Keep "false" for App Store / Play Store
# release builds — the SubscriptionScreen then shows subscriptions as not
# available and never opens an external payment flow. Set "true" only for
# dev / web-oriented builds. See docs/stripe-integration.md.
EXPO_PUBLIC_ENABLE_EXTERNAL_STRIPE_CHECKOUT=false

# Backend
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:8787
